# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,gairalabs.com,www.gairalabs.com

# ============================================================
# EMAIL CONFIGURATION
# ============================================================
# Choose ONE of the email providers below:

# OPTION 1: GMAIL (RECOMMENDED FOR FREE)
# ============================================================
# 1. Enable 2-Step Verification: https://myaccount.google.com
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Select Mail + Windows Computer
# 4. Copy the 16-character password below

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password-here
DEFAULT_FROM_EMAIL=your-email@gmail.com

# OPTION 2: HOTMAIL/OUTLOOK (ALTERNATIVE)
# ============================================================
# Uncomment below and comment out Gmail config above
# Same steps as Gmail: Create App Password from:
# https://account.microsoft.com/account/manage-my-microsoft-account

# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@hotmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password-here
# DEFAULT_FROM_EMAIL=your-email@hotmail.com

# OPTION 3: GOOGLE WORKSPACE (PROFESSIONAL)
# ============================================================
# Use same settings as Gmail (Option 1)
# but with your professional domain email

# Admin recipient email (where booking notifications go)
CONTACT_TO_EMAIL=admin@gairalabs.com

# ============================================================
# DATABASE (if using environment variable)
DATABASE_URL=

# SECURITY SETTINGS (Production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

